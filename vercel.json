{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^en.*" }],
      "missing": [{ "type": "cookie", "key": "i18n_locale" }],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^de.*" }],
      "missing": [{ "type": "cookie", "key": "i18n_locale" }],
      "destination": "/de",
      "permanent": false
    }
  ]
}
